          "interpreterVersion": 1,
          "code": "function run(width: number = 1600, length: number = 450, legHeight: number = 140) {\n  const W = Number(width), L = Number(length), legH = Number(legHeight);\n  if (![W, L, legH].every((v) => Number.isFinite(v) && v > 0)) return [];\n  try {\n    const r = 12, inset = 70, splay = 55, topGap = 3, clearance = 0.3, socketLen = 30, extra = 20;\n    const floorCut = replicad.drawRectangle(W * 2, L * 2).sketchOnPlane(\"XY\").extrude(100).translate([0, 0, -100]);\n    const out = [];\n    for (const [sx, sy] of [[-1, -1], [1, -1], [-1, 1], [1, 1]]) {\n      const top = [sx * (W / 2 - inset), sy * (L / 2 - inset), legH - topGap];\n      const foot = [sx * (W / 2 - inset + splay), sy * (L / 2 - inset + splay), 0];\n      const d = [top[0] - foot[0], top[1] - foot[1], top[2] - foot[2]];\n      const len = Math.hypot(d[0], d[1], d[2]);\n      const u = [d[0] / len, d[1] / len, d[2] / len];\n      // Start below the floor, then trim flat so the foot sits level.\n      const start = [foot[0] - u[0] * extra, foot[1] - u[1] * extra, foot[2] - u[2] * extra];\n      const leg = replicad.makeCylinder(r, len + extra, start, u).cut(floorCut.clone());\n      const sStart = [top[0] - u[0] * socketLen, top[1] - u[1] * socketLen, top[2] - u[2] * socketLen];\n      // Sleeve first so the leg (after it) stays whole and the sleeve becomes a thin clearance shell.\n      out.push(new Assembly({ geometry: replicad.makeCylinder(r + clearance, socketLen + 1, sStart, u), color: \"#FF6B6B\", tags: [\"keepout\"] }));\n      out.push(new Assembly({ geometry: leg, color: \"#1A1A1A\", tags: [\"legs\", \"hardware\"], bom: [\"Steel tube leg \" + 2 * r + \"mm dia x \" + Math.round(len) + \"mm, ends cut to splay angle\"] }));\n    }\n    return out;\n  } catch (e) {\n    console.error(\"Legs failed: \" + e);\n    return [];\n  }\n}\n",
          "compiledCode": "\"use strict\";\nfunction run(width = 1600, length = 450, legHeight = 140) {\n    const W = Number(width), L = Number(length), legH = Number(legHeight);\n    if (![W, L, legH].every((v) => Number.isFinite(v) && v > 0))\n        return [];\n    try {\n        const r = 12, inset = 70, splay = 55, topGap = 3, clearance = 0.3, socketLen = 30, extra = 20;\n        const floorCut = replicad.drawRectangle(W * 2, L * 2).sketchOnPlane(\"XY\").extrude(100).translate([0, 0, -100]);\n        const out = [];\n        for (const [sx, sy] of [[-1, -1], [1, -1], [-1, 1], [1, 1]]) {\n            const top = [sx * (W / 2 - inset), sy * (L / 2 - inset), legH - topGap];\n            const foot = [sx * (W / 2 - inset + splay), sy * (L / 2 - inset + splay), 0];\n            const d = [top[0] - foot[0], top[1] - foot[1], top[2] - foot[2]];\n            const len = Math.hypot(d[0], d[1], d[2]);\n            const u = [d[0] / len, d[1] / len, d[2] / len];\n            // Start below the floor, then trim flat so the foot sits level.\n            const start = [foot[0] - u[0] * extra, foot[1] - u[1] * extra, foot[2] - u[2] * extra];\n            const leg = replicad.makeCylinder(r, len + extra, start, u).cut(floorCut.clone());\n            const sStart = [top[0] - u[0] * socketLen, top[1] - u[1] * socketLen, top[2] - u[2] * socketLen];\n            // Sleeve first so the leg (after it) stays whole and the sleeve becomes a thin clearance shell.\n            out.push(new Assembly({ geometry: replicad.makeCylinder(r + clearance, socketLen + 1, sStart, u), color: \"#FF6B6B\", tags: [\"keepout\"] }));\n            out.push(new Assembly({ geometry: leg, color: \"#1A1A1A\", tags: [\"legs\", \"hardware\"], bom: [\"Steel tube leg \" + 2 * r + \"mm dia x \" + Math.round(len) + \"mm, ends cut to splay angle\"] }));\n        }\n        return out;\n    }\n    catch (e) {\n        console.error(\"Legs failed: \" + e);\n        return [];\n    }\n}\n"
        }
      ],

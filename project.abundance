          "interpreterVersion": 1,
          "code": "function run(width: number = 1600, length: number = 450, height: number = 750, thickness: number = 18, legHeight: number = 140) {\n  const W = Number(width), L = Number(length), H = Number(height), T = Number(thickness), legH = Number(legHeight);\n  if (![W, L, H, T, legH].every((v) => Number.isFinite(v) && v > 0)) return [];\n  try {\n    const carcassH = H - legH;\n    const ply = \"#D9B45B\";\n    // Odd finger count so both ends of each joint are side-panel tabs.\n    const n = Math.max(3, 2 * Math.round((L / 75 - 1) / 2) + 1);\n    const ys = [];\n    for (let k = 0; k <= n; k++) ys.push(k === n ? L / 2 : -L / 2 + (k * L) / n);\n\n    function box(xs: number, yl: number, zs: number, cx: number, cy: number, bz: number) {\n      return replicad.drawRectangle(xs, yl).sketchOnPlane(\"XY\").extrude(zs).translate([cx, cy, bz]);\n    }\n    function wrap(g: any, name: string, dims: string) {\n      return new Assembly({ geometry: g, color: ply, tags: [\"cnc\", \"carcass\"], bom: [name + \" \" + dims + \"mm plywood\"] });\n    }\n    // Side profile in the YZ plane with finger tabs reaching through the top and bottom panels.\n    function side(x0: number) {\n      const pts = [];\n      for (let k = 0; k < n; k++) {\n        const z = k % 2 === 0 ? legH : legH + T;\n        pts.push([ys[k], z], [ys[k + 1], z]);\n      }\n      for (let k = n - 1; k >= 0; k--) {\n        const z = k % 2 === 0 ? H : H - T;\n        pts.push([ys[k + 1], z], [ys[k], z]);\n      }\n      let d = replicad.draw(pts[0]);\n      for (let i = 1; i < pts.length; i++) d = d.lineTo(pts[i]);\n      return d.close().sketchOnPlane(\"YZ\").extrude(T).translate([x0, 0, 0]);\n    }\n\n    const r = Math.round;\n    // Each part is cut by the parts after it: side tabs notch the top/bottom, the back rabbets everything.\n    return [\n      wrap(box(W, L, T, 0, 0, H - T), \"Top\", r(W) + \"x\" + r(L) + \"x\" + T),\n      wrap(box(W, L, T, 0, 0, legH), \"Bottom\", r(W) + \"x\" + r(L) + \"x\" + T),\n      wrap(side(-W / 2), \"Left side\", T + \"x\" + r(L) + \"x\" + r(carcassH)),\n      wrap(side(W / 2 - T), \"Right side\", T + \"x\" + r(L) + \"x\" + r(carcassH)),\n      wrap(box(W - T, T, carcassH - T, 0, L / 2 - T / 2, legH + T / 2), \"Back\", r(W - T) + \"x\" + r(carcassH - T) + \"x\" + T),\n    ];\n  } catch (e) {\n    console.error(\"Carcass failed: \" + e);\n    return [];\n  }\n}\n",
          "compiledCode": "\"use strict\";\nfunction run(width = 1600, length = 450, height = 750, thickness = 18, legHeight = 140) {\n    const W = Number(width), L = Number(length), H = Number(height), T = Number(thickness), legH = Number(legHeight);\n    if (![W, L, H, T, legH].every((v) => Number.isFinite(v) && v > 0))\n        return [];\n    try {\n        const carcassH = H - legH;\n        const ply = \"#D9B45B\";\n        // Odd finger count so both ends of each joint are side-panel tabs.\n        const n = Math.max(3, 2 * Math.round((L / 75 - 1) / 2) + 1);\n        const ys = [];\n        for (let k = 0; k <= n; k++)\n            ys.push(k === n ? L / 2 : -L / 2 + (k * L) / n);\n        function box(xs, yl, zs, cx, cy, bz) {\n            return replicad.drawRectangle(xs, yl).sketchOnPlane(\"XY\").extrude(zs).translate([cx, cy, bz]);\n        }\n        function wrap(g, name, dims) {\n            return new Assembly({ geometry: g, color: ply, tags: [\"cnc\", \"carcass\"], bom: [name + \" \" + dims + \"mm plywood\"] });\n        }\n        // Side profile in the YZ plane with finger tabs reaching through the top and bottom panels.\n        function side(x0) {\n            const pts = [];\n            for (let k = 0; k < n; k++) {\n                const z = k % 2 === 0 ? legH : legH + T;\n                pts.push([ys[k], z], [ys[k + 1], z]);\n            }\n            for (let k = n - 1; k >= 0; k--) {\n                const z = k % 2 === 0 ? H : H - T;\n                pts.push([ys[k + 1], z], [ys[k], z]);\n            }\n            let d = replicad.draw(pts[0]);\n            for (let i = 1; i < pts.length; i++)\n                d = d.lineTo(pts[i]);\n            return d.close().sketchOnPlane(\"YZ\").extrude(T).translate([x0, 0, 0]);\n        }\n        const r = Math.round;\n        // Each part is cut by the parts after it: side tabs notch the top/bottom, the back rabbets everything.\n        return [\n            wrap(box(W, L, T, 0, 0, H - T), \"Top\", r(W) + \"x\" + r(L) + \"x\" + T),\n            wrap(box(W, L, T, 0, 0, legH), \"Bottom\", r(W) + \"x\" + r(L) + \"x\" + T),\n            wrap(side(-W / 2), \"Left side\", T + \"x\" + r(L) + \"x\" + r(carcassH)),\n            wrap(side(W / 2 - T), \"Right side\", T + \"x\" + r(L) + \"x\" + r(carcassH)),\n            wrap(box(W - T, T, carcassH - T, 0, L / 2 - T / 2, legH + T / 2), \"Back\", r(W - T) + \"x\" + r(carcassH - T) + \"x\" + T),\n        ];\n    }\n    catch (e) {\n        console.error(\"Carcass failed: \" + e);\n        return [];\n    }\n}\n"
        }
      ],

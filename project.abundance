            }
          ],
          "interpreterVersion": 1,
          "code": "function run(width: number = 1600, length: number = 450, height: number = 750, thickness: number = 18, legHeight: number = 140) {\n  const W = Number(width), L = Number(length), H = Number(height), T = Number(thickness), legH = Number(legHeight);\n  if (![W, L, H, T, legH].every((v) => Number.isFinite(v) && v > 0)) return [];\n  const carcassH = H - legH;\n  const ply = \"#D9B45B\";\n\n  function panel(xs: number, ys: number, zs: number, cx: number, cy: number, bz: number, name: string) {\n    const g = replicad.drawRectangle(xs, ys).sketchOnPlane(\"XY\").extrude(zs).translate([cx, cy, bz]);\n    return new Assembly({\n      geometry: g,\n      color: ply,\n      tags: [\"cnc\", \"carcass\"],\n      bom: [name + \" \" + Math.round(xs) + \"x\" + Math.round(ys) + \"x\" + Math.round(zs) + \"mm plywood\"],\n    });\n  }\n\n  const openW = W - 2 * T;\n  return [\n    panel(T, L, carcassH, -W / 2 + T / 2, 0, legH, \"Left side\"),\n    panel(T, L, carcassH, W / 2 - T / 2, 0, legH, \"Right side\"),\n    panel(openW, L, T, 0, 0, legH, \"Bottom\"),\n    panel(openW, L, T, 0, 0, H - T, \"Top\"),\n    panel(openW, T, carcassH - 2 * T, 0, L / 2 - T / 2, legH + T, \"Back\"),\n  ];\n}\n",
          "compiledCode": "\"use strict\";\nfunction run(width = 1600, length = 450, height = 750, thickness = 18, legHeight = 140) {\n    const W = Number(width), L = Number(length), H = Number(height), T = Number(thickness), legH = Number(legHeight);\n    if (![W, L, H, T, legH].every((v) => Number.isFinite(v) && v > 0))\n        return [];\n    const carcassH = H - legH;\n    const ply = \"#D9B45B\";\n    function panel(xs, ys, zs, cx, cy, bz, name) {\n        const g = replicad.drawRectangle(xs, ys).sketchOnPlane(\"XY\").extrude(zs).translate([cx, cy, bz]);\n        return new Assembly({\n            geometry: g,\n            color: ply,\n            tags: [\"cnc\", \"carcass\"],\n            bom: [name + \" \" + Math.round(xs) + \"x\" + Math.round(ys) + \"x\" + Math.round(zs) + \"mm plywood\"],\n        });\n    }\n    const openW = W - 2 * T;\n    return [\n        panel(T, L, carcassH, -W / 2 + T / 2, 0, legH, \"Left side\"),\n        panel(T, L, carcassH, W / 2 - T / 2, 0, legH, \"Right side\"),\n        panel(openW, L, T, 0, 0, legH, \"Bottom\"),\n        panel(openW, L, T, 0, 0, H - T, \"Top\"),\n        panel(openW, T, carcassH - 2 * T, 0, L / 2 - T / 2, legH + T, \"Back\"),\n    ];\n}\n"
        }
      ],

          "interpreterVersion": 1,
          "code": "function run(width: number = 1600, length: number = 450, height: number = 750, thickness: number = 18, legHeight: number = 140) {\n  const W = Number(width), L = Number(length), H = Number(height), T = Number(thickness), legH = Number(legHeight);\n  if (![W, L, H, T, legH].every((v) => Number.isFinite(v) && v > 0)) return [];\n  try {\n    const ply = \"#D9B45B\";\n    const carcassH = H - legH;\n    const setback = 50;               // clear space at the front for the door tracks\n    const yFront = -L / 2 + setback;\n    const yBack = L / 2 - T / 2;      // half-depth dado into the back panel\n    const depth = yBack - yFront;\n    const cy = (yFront + yBack) / 2;\n    const midZ = legH + carcassH / 2;\n    const shelfW = W / 2 - T;         // from half-depth dado in the side to the divider face\n\n    function panel(xs: number, ys: number, zs: number, cx: number, bz: number, name: string) {\n      const g = replicad.drawRectangle(xs, ys).sketchOnPlane(\"XY\").extrude(zs).translate([cx, cy, bz]);\n      return new Assembly({\n        geometry: g,\n        color: ply,\n        tags: [\"cnc\", \"interior\"],\n        bom: [name + \" \" + Math.round(xs) + \"x\" + Math.round(ys) + \"x\" + Math.round(zs) + \"mm plywood\"],\n      });\n    }\n\n    return [\n      panel(T, depth, carcassH - T, 0, legH + T / 2, \"Divider\"),\n      panel(shelfW, depth, T, -W / 4, midZ - T / 2, \"Left shelf\"),\n      panel(shelfW, depth, T, W / 4, midZ - T / 2, \"Right shelf\"),\n    ];\n  } catch (e) {\n    console.error(\"Interior failed: \" + e);\n    return [];\n  }\n}\n",
          "compiledCode": "\"use strict\";\nfunction run(width = 1600, length = 450, height = 750, thickness = 18, legHeight = 140) {\n    const W = Number(width), L = Number(length), H = Number(height), T = Number(thickness), legH = Number(legHeight);\n    if (![W, L, H, T, legH].every((v) => Number.isFinite(v) && v > 0))\n        return [];\n    try {\n        const ply = \"#D9B45B\";\n        const carcassH = H - legH;\n        const setback = 50; // clear space at the front for the door tracks\n        const yFront = -L / 2 + setback;\n        const yBack = L / 2 - T / 2; // half-depth dado into the back panel\n        const depth = yBack - yFront;\n        const cy = (yFront + yBack) / 2;\n        const midZ = legH + carcassH / 2;\n        const shelfW = W / 2 - T; // from half-depth dado in the side to the divider face\n        function panel(xs, ys, zs, cx, bz, name) {\n            const g = replicad.drawRectangle(xs, ys).sketchOnPlane(\"XY\").extrude(zs).translate([cx, cy, bz]);\n            return new Assembly({\n                geometry: g,\n                color: ply,\n                tags: [\"cnc\", \"interior\"],\n                bom: [name + \" \" + Math.round(xs) + \"x\" + Math.round(ys) + \"x\" + Math.round(zs) + \"mm plywood\"],\n            });\n        }\n        return [\n            panel(T, depth, carcassH - T, 0, legH + T / 2, \"Divider\"),\n            panel(shelfW, depth, T, -W / 4, midZ - T / 2, \"Left shelf\"),\n            panel(shelfW, depth, T, W / 4, midZ - T / 2, \"Right shelf\"),\n        ];\n    }\n    catch (e) {\n        console.error(\"Interior failed: \" + e);\n        return [];\n    }\n}\n"
        }

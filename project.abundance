          "interpreterVersion": 1,
          "code": "function run(width: number = 1600, length: number = 450, height: number = 750, thickness: number = 18, legHeight: number = 140) {\n  const W = Number(width), L = Number(length), H = Number(height), T = Number(thickness), legH = Number(legHeight);\n  if (![W, L, H, T, legH].every((v) => Number.isFinite(v) && v > 0)) return [];\n  try {\n    const openingW = W - 2 * T;\n    const railD = 42;                 // wall 6 + groove 12 + wall 6 + groove 12 + wall 6\n    const groove = 12;\n    const botH = 12, botDepth = 6;\n    const topH = 20, topDepth = 14;\n    const maxSeg = 250;               // print bed limit\n    const yRail = -L / 2 + railD / 2;\n    const grooveYs = [-L / 2 + 12, -L / 2 + 30];\n    const zBot = legH + T;\n    const zTop = H - T - topH;\n    const nSeg = Math.ceil(openingW / maxSeg);\n    const segW = openingW / nSeg;\n\n    function box(xs: number, ys: number, zs: number, cx: number, cy: number, bz: number) {\n      return replicad.drawRectangle(xs, ys).sketchOnPlane(\"XY\").extrude(zs).translate([cx, cy, bz]);\n    }\n\n    const parts = [];\n    for (let i = 0; i < nSeg; i++) {\n      const cx = -openingW / 2 + segW * (i + 0.5);\n      const label = Math.round(segW) + \"x\" + railD;\n      parts.push(new Assembly({ geometry: box(segW, railD, botH, cx, yRail, zBot), color: \"#E8E4DA\", tags: [\"3dprint\", \"track\"], bom: [\"Bottom track segment \" + label + \"x\" + botH + \"mm PETG\"] }));\n      parts.push(new Assembly({ geometry: box(segW, railD, topH, cx, yRail, zTop), color: \"#E8E4DA\", tags: [\"3dprint\", \"track\"], bom: [\"Top track segment \" + label + \"x\" + topH + \"mm PETG\"] }));\n    }\n    // Keepout channels come last so they cut the grooves into every segment.\n    for (const gy of grooveYs) {\n      parts.push(new Assembly({ geometry: box(openingW + 2, groove, botDepth + 1, 0, gy, zBot + botH - botDepth), color: \"#FF6B6B\", tags: [\"keepout\"] }));\n      parts.push(new Assembly({ geometry: box(openingW + 2, groove, topDepth + 1, 0, gy, zTop - 1), color: \"#FF6B6B\", tags: [\"keepout\"] }));\n    }\n    return parts;\n  } catch (e) {\n    console.error(\"DoorTracks failed: \" + e);\n    return [];\n  }\n}\n",
          "compiledCode": "\"use strict\";\nfunction run(width = 1600, length = 450, height = 750, thickness = 18, legHeight = 140) {\n    const W = Number(width), L = Number(length), H = Number(height), T = Number(thickness), legH = Number(legHeight);\n    if (![W, L, H, T, legH].every((v) => Number.isFinite(v) && v > 0))\n        return [];\n    try {\n        const openingW = W - 2 * T;\n        const railD = 42; // wall 6 + groove 12 + wall 6 + groove 12 + wall 6\n        const groove = 12;\n        const botH = 12, botDepth = 6;\n        const topH = 20, topDepth = 14;\n        const maxSeg = 250; // print bed limit\n        const yRail = -L / 2 + railD / 2;\n        const grooveYs = [-L / 2 + 12, -L / 2 + 30];\n        const zBot = legH + T;\n        const zTop = H - T - topH;\n        const nSeg = Math.ceil(openingW / maxSeg);\n        const segW = openingW / nSeg;\n        function box(xs, ys, zs, cx, cy, bz) {\n            return replicad.drawRectangle(xs, ys).sketchOnPlane(\"XY\").extrude(zs).translate([cx, cy, bz]);\n        }\n        const parts = [];\n        for (let i = 0; i < nSeg; i++) {\n            const cx = -openingW / 2 + segW * (i + 0.5);\n            const label = Math.round(segW) + \"x\" + railD;\n            parts.push(new Assembly({ geometry: box(segW, railD, botH, cx, yRail, zBot), color: \"#E8E4DA\", tags: [\"3dprint\", \"track\"], bom: [\"Bottom track segment \" + label + \"x\" + botH + \"mm PETG\"] }));\n            parts.push(new Assembly({ geometry: box(segW, railD, topH, cx, yRail, zTop), color: \"#E8E4DA\", tags: [\"3dprint\", \"track\"], bom: [\"Top track segment \" + label + \"x\" + topH + \"mm PETG\"] }));\n        }\n        // Keepout channels come last so they cut the grooves into every segment.\n        for (const gy of grooveYs) {\n            parts.push(new Assembly({ geometry: box(openingW + 2, groove, botDepth + 1, 0, gy, zBot + botH - botDepth), color: \"#FF6B6B\", tags: [\"keepout\"] }));\n            parts.push(new Assembly({ geometry: box(openingW + 2, groove, topDepth + 1, 0, gy, zTop - 1), color: \"#FF6B6B\", tags: [\"keepout\"] }));\n        }\n        return parts;\n    }\n    catch (e) {\n        console.error(\"DoorTracks failed: \" + e);\n        return [];\n    }\n}\n"
        }
      ],

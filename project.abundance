          "interpreterVersion": 1,
          "code": "function run(width: number = 1600, length: number = 450, height: number = 750, thickness: number = 18, legHeight: number = 140) {\n  const W = Number(width), L = Number(length), H = Number(height), T = Number(thickness), legH = Number(legHeight);\n  if (![W, L, H, T, legH].every((v) => Number.isFinite(v) && v > 0)) return [];\n  try {\n    const openingW = W - 2 * T;\n    const td = 10;                    // door thickness, rides in 12 mm grooves\n    const overlap = 40;\n    const doorW = openingW / 2 + overlap / 2;\n    const bz = legH + T + 12 - 6;     // resting on the bottom groove floor\n    const topZ = H - T - 14;          // leaves lift clearance in the deeper top groove\n    const doorH = topZ - bz;\n    const pullR = 18, pullInset = 60;\n\n    function door(x0: number, cy: number, pullX: number, color: string, name: string) {\n      let g = replicad.drawRectangle(doorW, td).sketchOnPlane(\"XY\").extrude(doorH).translate([x0 + doorW / 2, cy, bz]);\n      const pull = replicad.makeCylinder(pullR, td + 4, [pullX, cy - td / 2 - 2, bz + doorH / 2], [0, 1, 0]);\n      g = g.cut(pull);\n      return new Assembly({\n        geometry: g,\n        color: color,\n        tags: [\"cnc\", \"door\"],\n        bom: [name + \" \" + Math.round(doorW) + \"x\" + Math.round(doorH) + \"x\" + td + \"mm plywood\"],\n      });\n    }\n\n    const leftX0 = -openingW / 2;\n    const rightX0 = openingW / 2 - doorW;\n    return [\n      door(leftX0, -L / 2 + 12, leftX0 + pullInset, \"#B23A2E\", \"Left sliding door\"),\n      door(rightX0, -L / 2 + 30, rightX0 + doorW - pullInset, \"#2E5A8C\", \"Right sliding door\"),\n    ];\n  } catch (e) {\n    console.error(\"SlidingDoors failed: \" + e);\n    return [];\n  }\n}\n",
          "compiledCode": "\"use strict\";\nfunction run(width = 1600, length = 450, height = 750, thickness = 18, legHeight = 140) {\n    const W = Number(width), L = Number(length), H = Number(height), T = Number(thickness), legH = Number(legHeight);\n    if (![W, L, H, T, legH].every((v) => Number.isFinite(v) && v > 0))\n        return [];\n    try {\n        const openingW = W - 2 * T;\n        const td = 10; // door thickness, rides in 12 mm grooves\n        const overlap = 40;\n        const doorW = openingW / 2 + overlap / 2;\n        const bz = legH + T + 12 - 6; // resting on the bottom groove floor\n        const topZ = H - T - 14; // leaves lift clearance in the deeper top groove\n        const doorH = topZ - bz;\n        const pullR = 18, pullInset = 60;\n        function door(x0, cy, pullX, color, name) {\n            let g = replicad.drawRectangle(doorW, td).sketchOnPlane(\"XY\").extrude(doorH).translate([x0 + doorW / 2, cy, bz]);\n            const pull = replicad.makeCylinder(pullR, td + 4, [pullX, cy - td / 2 - 2, bz + doorH / 2], [0, 1, 0]);\n            g = g.cut(pull);\n            return new Assembly({\n                geometry: g,\n                color: color,\n                tags: [\"cnc\", \"door\"],\n                bom: [name + \" \" + Math.round(doorW) + \"x\" + Math.round(doorH) + \"x\" + td + \"mm plywood\"],\n            });\n        }\n        const leftX0 = -openingW / 2;\n        const rightX0 = openingW / 2 - doorW;\n        return [\n            door(leftX0, -L / 2 + 12, leftX0 + pullInset, \"#B23A2E\", \"Left sliding door\"),\n            door(rightX0, -L / 2 + 30, rightX0 + doorW - pullInset, \"#2E5A8C\", \"Right sliding door\"),\n        ];\n    }\n    catch (e) {\n        console.error(\"SlidingDoors failed: \" + e);\n        return [];\n    }\n}\n"
        }

          "interpreterVersion": 1,
          "code": "function run(width: number = 1600, length: number = 450, legHeight: number = 140) {\n  const W = Number(width), L = Number(length), legH = Number(legHeight);\n  if (![W, L, legH].every((v) => Number.isFinite(v) && v > 0)) return [];\n  try {\n    const inset = 70, size = 70, blockH = 25, screwR = 2.25, screwOff = 25;\n    const out = [];\n    for (const [sx, sy] of [[-1, -1], [1, -1], [-1, 1], [1, 1]]) {\n      const cx = sx * (W / 2 - inset), cy = sy * (L / 2 - inset);\n      let g = replicad.drawRectangle(size, size).sketchOnPlane(\"XY\").extrude(blockH).translate([cx, cy, legH - blockH]);\n      for (const [hx, hy] of [[-1, -1], [1, -1], [-1, 1], [1, 1]]) {\n        g = g.cut(replicad.makeCylinder(screwR, blockH + 2, [cx + hx * screwOff, cy + hy * screwOff, legH - blockH - 1], [0, 0, 1]));\n      }\n      out.push(new Assembly({ geometry: g, color: \"#E8E4DA\", tags: [\"3dprint\", \"bracket\"], bom: [\"Leg bracket \" + size + \"x\" + size + \"x\" + blockH + \"mm PETG + 4x 4mm wood screws\"] }));\n    }\n    return out;\n  } catch (e) {\n    console.error(\"LegBrackets failed: \" + e);\n    return [];\n  }\n}\n",
          "compiledCode": "\"use strict\";\nfunction run(width = 1600, length = 450, legHeight = 140) {\n    const W = Number(width), L = Number(length), legH = Number(legHeight);\n    if (![W, L, legH].every((v) => Number.isFinite(v) && v > 0))\n        return [];\n    try {\n        const inset = 70, size = 70, blockH = 25, screwR = 2.25, screwOff = 25;\n        const out = [];\n        for (const [sx, sy] of [[-1, -1], [1, -1], [-1, 1], [1, 1]]) {\n            const cx = sx * (W / 2 - inset), cy = sy * (L / 2 - inset);\n            let g = replicad.drawRectangle(size, size).sketchOnPlane(\"XY\").extrude(blockH).translate([cx, cy, legH - blockH]);\n            for (const [hx, hy] of [[-1, -1], [1, -1], [-1, 1], [1, 1]]) {\n                g = g.cut(replicad.makeCylinder(screwR, blockH + 2, [cx + hx * screwOff, cy + hy * screwOff, legH - blockH - 1], [0, 0, 1]));\n            }\n            out.push(new Assembly({ geometry: g, color: \"#E8E4DA\", tags: [\"3dprint\", \"bracket\"], bom: [\"Leg bracket \" + size + \"x\" + size + \"x\" + blockH + \"mm PETG + 4x 4mm wood screws\"] }));\n        }\n        return out;\n    }\n    catch (e) {\n        console.error(\"LegBrackets failed: \" + e);\n        return [];\n    }\n}\n"
